<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shell="using:TransmissionNet.Shell"
             xmlns:torrents="using:TransmissionNet.Torrents"
             xmlns:settings="using:TransmissionNet.Settings"
             x:Class="TransmissionNet.MainApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Locale/en_US.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <shell:MainShellViewModel x:Key="MainShellViewModel"/>
            <torrents:TorrentsViewModel x:Key="TorrentsViewModel"/>
            <torrents:FilterSortingViewModel x:Key="FilterSortingViewModel"/>
            <torrents:StatisticsViewModel x:Key="StatisticsViewModel"/>
            <torrents:FilePageViewModel x:Key="FilePageViewModel"/>
            <settings:AppSettingsViewModel x:Key="AppSettingsViewModel"/>
            <settings:ServerSettingsViewModel x:Key="ServerSettingsViewModel"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
