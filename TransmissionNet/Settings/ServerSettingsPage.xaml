<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:settings="using:TransmissionNet.Settings"
             x:Class="TransmissionNet.Settings.ServerSettingsPage"
             BindingContext="{StaticResource ServerSettingsViewModel}">
    
    <ContentPage.Resources>
        <ResourceDictionary Source="SettingsResource.xaml"/>
    </ContentPage.Resources>
    <Grid RowSpacing="5"
          Padding="5, 5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CollectionView x:DataType="settings:ServerSettingsViewModel"
                        ItemsUpdatingScrollMode="KeepScrollOffset"
                        SelectionMode="None"
                        ItemsSource="{Binding SettingsCollection}"
                        ItemTemplate="{StaticResource ValueTypeSelector}"
                        ItemSizingStrategy="MeasureAllItems">
        </CollectionView>
        <HorizontalStackLayout x:DataType="settings:ServerSettingsViewModel"
                               Grid.Row="1" Spacing="8" HorizontalOptions="Center">
            <Label Text="{Binding Version, StringFormat='{0}'}"
                   Style="{x:StaticResource StatisticHeader}"
                   VerticalOptions="Center"/>
            <Label VerticalOptions="Center"
                   Style="{x:StaticResource StatisticHeader}"
                   IsVisible="{Binding IsPortOpen, Converter={toolkit:IsNotNullConverter}}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPortOpen}" Value="True">
                        <Setter Property="Text" Value="🟢 Port is open"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPortOpen}" Value="False">
                        <Setter Property="Text" Value="🔴 Port is closed"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>