<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TransmissionNet.Torrents.AddTorrentPopup"
             Title="Add Torrent">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="12">

        <Label Grid.Row="0" Text="Add Torrent"
               FontFamily="OpenSansSemibold"
               FontSize="20"
               HorizontalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>

        <VerticalStackLayout Grid.Row="1" Spacing="12">

            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="Download Directory" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                <Entry x:Name="DirectoryEntry" Grid.Column="1" Keyboard="Text" VerticalOptions="Center">
                    <Entry.Behaviors>
                        <toolkit:UriValidationBehavior Flags="ValidateOnValueChanged"
                                                       UriKind="Relative"
                                                       ValidStyle="{StaticResource ValidEntryStyle}"
                                                       InvalidStyle="{StaticResource InvalidEntryStyle}"/>
                    </Entry.Behaviors>
                </Entry>
            </Grid>

            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="Paused" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                <Switch x:Name="PausedSwitch" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Start"/>
            </Grid>

            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="Sequential Download" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                <Switch x:Name="SequentialSwitch" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Start"/>
            </Grid>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                <Button Text="Cancel" Clicked="OnCancelClicked"/>
                <Button Text="Add" Clicked="OnAddClicked"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- Movie description area -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="MoviePanel" Spacing="8" IsVisible="False">

                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" IsVisible="False"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image x:Name="PosterImage" Grid.Column="0" WidthRequest="120" HeightRequest="180" Aspect="AspectFill"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Start">
                        <Label x:Name="TitleLabel" FontFamily="OpenSansSemibold" FontSize="18" LineBreakMode="WordWrap"/>
                        <Label x:Name="GenresLabel" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                        <Label x:Name="RatingLabel" FontSize="14" FontFamily="OpenSansSemibold"/>
                        <Grid x:Name="DirectorPanel" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                            <Image x:Name="DirectorPhoto" Grid.Column="0" WidthRequest="64" HeightRequest="64" Aspect="AspectFill" VerticalOptions="Center">
                                <Image.Clip>
                                    <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/>
                                </Image.Clip>
                            </Image>
                            <Label x:Name="DirectorLabel" Grid.Column="1" FontSize="14" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>

                <Label x:Name="DescriptionLabel" FontSize="14" LineBreakMode="WordWrap"/>

                <Label x:Name="ActorsHeader" Text="Актёры" FontFamily="OpenSansSemibold" FontSize="16" Margin="0,8,0,4" IsVisible="False"/>
                <VerticalStackLayout x:Name="ActorsPanel" Spacing="6"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
