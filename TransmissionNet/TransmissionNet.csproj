<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <RuntimeIdentifier>maccatalyst-arm64</RuntimeIdentifier>
    </PropertyGroup>
    
    <PropertyGroup>
        <TargetFrameworks>net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
        <ValidateXcodeVersion>false</ValidateXcodeVersion>
        <OutputType>Exe</OutputType>
        <RootNamespace>TransmissionNet</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
        <ApplicationDisplayVersion>1.3.6</ApplicationDisplayVersion>
        <ApplicationVersion>1.3.6</ApplicationVersion>

        <!-- Display name -->
        <ApplicationTitle>TransmissionNet</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>lobanov.transmissionnet</ApplicationId>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">26.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">26.0</SupportedOSPlatformVersion>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.png"/>

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\appiconfg.png"/>

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" Resize="True" BaseSize="185,185"/>

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*"/>

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui" Version="17.0.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.130" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
        <PackageReference Include="Microsoft.Maui.Core" Version="11.0.10" />
    </ItemGroup>

    <ItemGroup>
      <MauiXaml Update="TorrentPage\TorrentsPage.xaml">
        <SubType>Designer</SubType>
      </MauiXaml>
      <MauiXaml Update="Shell\MainShell.xaml">
        <SubType>Designer</SubType>
      </MauiXaml>
      <MauiXaml Update="App\App.xaml">
        <SubType>Designer</SubType>
      </MauiXaml>
      <MauiXaml Update="Settings\AppSettingsPage.xaml">
        <SubType>Designer</SubType>
      </MauiXaml>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="TorrentPage\TorrentsPage.xaml.cs">
        <DependentUpon>MainPage.xaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Shell\MainShell.xaml.cs">
        <DependentUpon>AppShell.xaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="App\App.xaml.cs">
        <DependentUpon>App.xaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Settings\AppSettingsPage.xaml.cs">
        <DependentUpon>TorrentsPage.xaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Resources\Splash\" />
      <Folder Include="Utils\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Transmission.API.RPC.NET\Transmission.API.RPC.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\README.md">
        <Link>README.md</Link>
      </Content>
    </ItemGroup>

</Project>
